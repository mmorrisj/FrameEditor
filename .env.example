# FrameKit directories and settings.
# Copy this file to .env (same folder) and edit. .env is not committed to git.
# A variable already set in the real environment wins over this file.
# Paths may be absolute or relative to this folder. Quotes are optional.
# Lists use ";" between folders on Windows (":" on Linux/macOS).
# Check the result with:  python -m framekit dirs

# ---- Where FrameKit keeps its own files -------------------------------------
# Index, caches, thumbnails, extracted frames. Default: work (in this folder).
#FRAMEKIT_WORK=D:\FrameKit\work

# Library folder list and tool settings file. Default: framekit.json (in this folder).
#FRAMEKIT_CONFIG=D:\FrameKit\framekit.json

# Uploaded videos. Default: <work>\uploads
#FRAMEKIT_UPLOADS=D:\FrameKit\uploads

# Zips, contact sheets, exported frames and groups. Default: <work>\exports
#FRAMEKIT_EXPORTS=D:\FrameKit\exports

# Files moved aside by duplicate and near-duplicate removal (undoable from here).
# Keep it on the same drive as your videos so moves are instant. Default: <work>\quarantine
#FRAMEKIT_QUARANTINE=D:\FrameKit\quarantine

# Colour match sessions: rendered videos, handoff frames, kept PNGs. Default: <work>\colormatch
#FRAMEKIT_COLORMATCH_DIR=D:\FrameKit\renders

# ---- Folders to work on ------------------------------------------------------
# Library folders, added to any saved with "framekit roots add".
#FRAMEKIT_ROOTS=D:\Videos;E:\Clips

# Lineage folders (indexed non-recursively), added to any saved on the Lineage page.
#FRAMEKIT_LINEAGE_DIRS=D:\Generated\finished

# Unique frames drop folder, if none is saved on the page. Default: <work>\frames-inbox
#FRAMEKIT_FRAME_INBOX=D:\Frames\inbox

# ---- Web app -------------------------------------------------------------------
# 127.0.0.1 = this computer only. 0.0.0.0 = your whole network (there is no login).
#FRAMEKIT_HOST=127.0.0.1
#FRAMEKIT_PORT=8082

# ---- CLIP model ------------------------------------------------------------------
# Once the model has been downloaded, this stops the Hugging Face library from
# contacting the internet at all (it otherwise checks for model updates on load).
#HF_HUB_OFFLINE=1
#FRAMEKIT_CLIP_MODEL=openai/clip-vit-base-patch32

# Frames saved as handoff PNGs from the Lineage end-frame editor. Default: <work>\lineage\handoff
#FRAMEKIT_HANDOFF_DIR=D:\Generated\handoff
